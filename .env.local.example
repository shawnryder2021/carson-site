# Copy to .env.local and fill in your keys

# OpenAI (AI concierge, finder, etc.)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Supabase (admin + dynamic content)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# kie.ai (GPT Image 2 banner generation)
KIE_API_KEY=your-kie-api-key

# Web analytics (shawnryder.site stats API)
ANALYTICS_API_KEY=your-analytics-api-key
ANALYTICS_SITE_ID=56
ANALYTICS_BASE=https://shawnryder.site

# OpenRouter (multi-model AI testing for descriptions)
OPENROUTER_API_KEY=sk-or-v1-...

# Google Analytics 4 (site tracking + conversion events)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Google Analytics 4 Data API (server-to-server reporting for /admin/reports)
# Setup: enable "Google Analytics Data API" in Google Cloud Console, create a
# service account + JSON key, grant it Viewer access on the GA4 property
# (Admin > Property Access Management), then copy the numeric property ID
# from Admin > Property Settings (different from the G-XXXXXXXXXX ID above).
GA4_PROPERTY_ID=123456789
GA4_CLIENT_EMAIL=reports-reader@your-project.iam.gserviceaccount.com
GA4_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Report digest email (reuses Resend already configured for CarFinder alerts)
# RESEND_API_KEY=re_...
# ALERT_FROM_EMAIL=Carson Exports <onboarding@resend.dev>
# SYNC_SECRET=... (shared secret for scheduled functions; already set in Netlify)
# SUPABASE_SERVICE_ROLE_KEY=... (already set in Netlify)
